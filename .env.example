# Create a sending-only API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Keep the real receiving address private in .env.local and your hosting provider.
CONTACT_TO_EMAIL=you@example.com

# The default Resend sender can deliver only to the email registered on your Resend account.
CONTACT_FROM_EMAIL="KDBN Portfolio <onboarding@resend.dev>"
